# ================================================================
# Tribute — Environment Variables
# Copy to .env.local and fill in your values.
# Never commit .env.local to git.
# ================================================================


# ── Supabase ─────────────────────────────────────────────────────
# Found in: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Internal flag — keep 1 in production
NEXT_PUBLIC_SERVER_AUTH_GATE=1


# ── Bunny.net ─────────────────────────────────────────────────────
# Found in: Bunny dashboard → Storage / Stream zones
BUNNY_STREAM_LIBRARY_ID=your-stream-library-id
BUNNY_API_KEY=your-bunny-api-key
BUNNY_STORAGE_ZONE=your-storage-zone-name
BUNNY_STORAGE_API_KEY=your-storage-zone-password
BUNNY_CDN_HOSTNAME=your-zone.b-cdn.net
BUNNY_CDN_TOKEN_SECRET=your-token-auth-secret
NEXT_PUBLIC_BUNNY_STREAM_LIBRARY_ID=your-stream-library-id


# ── Privy (embedded wallets) ──────────────────────────────────────
# Found in: Privy dashboard → Settings → API keys
# STUB is active when these are blank — generates mock wallet addresses.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Used to verify webhook signatures from Privy payment events
PRIVY_WEBHOOK_SECRET=


# ── Age verification — Verifymy (Layer 1, silent) ─────────────────
# Found in: Verifymy developer portal
# STUB auto-passes when blank (all users pass in development).
VERIFYMY_API_KEY=


# ── Age verification — Yoti (Layer 2, selfie fallback) ───────────
# Found in: Yoti developer dashboard
# Required when Verifymy returns inconclusive.
YOTI_SDK_ID=
YOTI_KEY_FILE_PATH=/path/to/yoti-private-key.pem


# ── KYC — Sumsub (dom payout verification) ───────────────────────
# Found in: Sumsub dashboard → Developers → API keys
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=


# ── Content moderation — Hive ─────────────────────────────────────
# Found in: Hive moderation dashboard
# All uploads are blocked until this is set in production.
HIVE_API_KEY=


# ── Email — Resend ────────────────────────────────────────────────
# Found in: Resend dashboard → API keys
# Used for VIP access notifications, task approval emails.
# Supabase handles OTP emails via its own SMTP config.
RESEND_API_KEY=


# ── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
